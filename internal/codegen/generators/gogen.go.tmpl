			return append(x, bson.E{Key: {{ $type }}{{ $fieldName }}Name(), Value: v})
			}


			func (x {{ $type }}) Get{{ $type }}{{ $fieldName }}() ({{ index $specs 0 }}, error) {
				for _, i := range x {
					if i.Key != {{ $type }}{{ $fieldName }}Name() {
						continue
					}
					{{ $concreteType := concreteType (index $specs 0) }}
					{{- if eq $concreteType.Depth 0 }}
						out, ok := i.Value.({{ index $specs 0 }})
						if !ok {
							var zero {{ index $specs 0 }}
							typ := reflect.TypeFor[{{ index $specs 0 }}]()
							return zero, bson.ValueDecoderError{ 
								Name: {{ $type }}{{ $fieldName }}Name(), 
								Types: []reflect.Type{typ}, 
								Kinds: []reflect.Kind{typ.Kind()}, 
								Received: reflect.ValueOf(i.Value),
							}
						}
						return out, nil
					{{- else }}
					switch t := i.Value.(type) {
						case {{ index $specs 0 }}: { 
							return t, nil
						}
						case {{ $concreteType.Type }}: { 
							return {{- range $i := $concreteType.Depth}} new( {{- end }} t {{- range $i := $concreteType.Depth}} {{- if gt $i 0}} ) {{- end}} {{- end}}), nil
						}
						case nil: {
							var zero {{ index $specs 0 }}
							return zero, nil
						}
						default: {
							var zero {{ index $specs 0 }}
							typ := reflect.TypeFor[{{ index $specs 0 }}]()
							return zero, bson.ValueDecoderError{ 
								Name: {{ $type }}{{ $fieldName }}Name(), 
								Types: []reflect.Type{typ}, 
								Kinds: []reflect.Kind{typ.Kind()}, 
								Received: reflect.ValueOf(t),
							}
						}
					}
					{{- end }}
				}

				var zero {{ index $specs 0 }}
				return zero, bsoncore.ErrElementNotFound
			}

			func {{ $type }}{{ $fieldName }}BsonE(v  {{ index $specs 0 }}) bson.E {
			return bson.E{Key: {{ $type }}{{ $fieldName }}Name(), Value: v}
			}
		{{- end }}



