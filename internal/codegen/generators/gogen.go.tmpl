			}

			func (x {{ $type }}) Set{{ $type }}{{ $fieldName }}(v  {{ $type }}{{ $fieldName }}) {{ $type }} {
			for i := range x {
				if x[i].Key == {{ $type }}{{ $fieldName }}Name() {
					x[i].Value = v
					return x
				}
			}
			return append(x, bson.E{Key: {{ $type }}{{ $fieldName }}Name(), Value: v})
			}

			func (x {{ $type }}) Get{{ $type }}{{ $fieldName }}() ({{ $type }}{{ $fieldName }}, error) {
				for _, i := range x {
					if i.Key != {{ $type }}{{ $fieldName }}Name() {
						continue
					}
					switch t := i.Value.(type) {
						case {{ $type }}{{ $fieldName }}: {
							return t, nil
						}
						case bson.D: {
							return {{ $type }}{{ $fieldName }}(t), nil
						}
						case bson.Raw: {
							var d bson.D
							if err := bson.Unmarshal(t, &d); err != nil {
								return nil, err
							}
							return {{ $type }}{{ $fieldName }}(d), nil
						}
						case nil: {
							return nil, nil
						}
						default: {
							typ := reflect.TypeFor[{{ $type }}{{ $fieldName }}]()
							return nil, bson.ValueDecoderError{ 
								Name: {{ $type }}{{ $fieldName }}Name(), 
								Types: []reflect.Type{typ}, 
								Kinds: []reflect.Kind{typ.Kind()}, 
								Received: reflect.ValueOf(t),
							}
						}
					}
				}

				return nil, bsoncore.ErrElementNotFound
			}

			func {{ $type }}{{ $fieldName }}BsonE(v  {{ $type }}{{ $fieldName }}) bson.E {
			return bson.E{Key: {{ $type }}{{ $fieldName }}Name(), Value: v}
			}

		{{- else }}
			type {{ $type }}{{ $fieldName }}Specs struct {
			{{ $fieldName }}  {{ index $specs 0 }}  {{ index $specs 1 }}
			}

