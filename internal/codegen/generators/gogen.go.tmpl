package {{ .PackageName }}

import (
{{- range $import := .ImportList }}
	"{{ $import }}"
{{- end }}

)

{{- range $type, $fields := .Fields }}
	{{- if hasPrefix $type "$" }} 
		// +--------------------------------------------------+
		// | Begin Enum Definition For: {{ $type }}
		// +--------------------------------------------------+
		{{ $typeName := trimPrefix $type "$" }}
		type {{ $typeName }} {{ index (index $fields "$type") 0}}
		{{- range $enumKey, $enumValue := $fields }}
			{{- if eq $enumKey "$type"}} {{ continue }} {{- end }}
			const {{ $enumKey }}  {{ $typeName }} = {{ index $enumValue 0 }} 
		{{- end }}
		// +--------------------------------------------------+
		// | End Enum Definition For: {{ $type }}
		// +--------------------------------------------------+
		{{ continue }} 
	{{- end }}

	// +--------------------------------------------------+
	// | Begin Type Definition For: {{ $type }}
	// +--------------------------------------------------+

	type {{ $type }} bson.D

	{{- range $fieldName, $specs := $fields }}

		// +--------------------------------------------------+
		// |    Begin Field Definition For: {{ $fieldName }}
		// +--------------------------------------------------+


		{{- if hasPrefix (index $specs 0) "$" }} 
			type {{ $type }}{{ $fieldName }}Specs struct {
				{{ $fieldName }}  {{ trimPrefix (index $specs 0) "$" }}  {{ index $specs 1 }}
			}

			var _{{ $type }}{{ $fieldName }}Name = tools.FieldName[{{ $type }}{{ $fieldName }}Specs]()

			func {{ $type }}{{ $fieldName }}Name() string { 
				return _{{ $type }}{{ $fieldName }}Name
			}
			
			{{ continue }}
		{{- end }}
		
		{{ $preferredType := (whichType (index $specs 0)) }}

		{{- if ne $preferredType (index $specs 0) }} 
			type {{ $type }}{{ $fieldName }}Specs[T any] struct {
				{{ $fieldName }} {{ $preferredType }} {{ index $specs 1 }}
			}
			var _{{ $type }}{{ $fieldName }}Name = tools.FieldName[{{ $type }}{{ $fieldName }}Specs[any]]()
			{{ template "functions" (dict "Field" (printf "%s%s" $type $fieldName) "Name" (printf "%s%s" $type $fieldName) "Specs" $specs "Type" $type "IsBsonType" true) }}

		{{- else }}
			type {{ $type }}{{ $fieldName }}Specs struct {
				{{ $fieldName }}  {{ index $specs 0 }}  {{ index $specs 1 }}
			}
			var _{{ $type }}{{ $fieldName }}Name = tools.FieldName[{{ $type }}{{ $fieldName }}Specs]()

			{{ template "functions" (dict "Field" (index $specs 0)  "Name" (printf "%s%s" $type $fieldName) "Specs"  $specs "Type" $type "IsBsonType" false) }}
		{{- end }}





		{{/* 
        func {{ $fieldName }}(v {{ index $specs 0 }}) {{ $type }} {
            return {{ $type }}(bson.E{Key: {{ $fieldName }}Name(), Value: v})
        }
        
        func {{ $fieldName }}IfPresent(v {{- if not (hasPrefix (index $specs 0) "*") }} *{{- end}} {{- index $specs 0 }}) {{ $type }} {
            if v == nil {
                return {{ $type }}(bson.E{})
            }
            return {{ $type }}(bson.E{Key: {{ $fieldName }}Name(), Value: v})
        } */}}

		// +--------------------------------------------------+
		// |    End Field Definition For: {{ $fieldName }}
		// +--------------------------------------------------+

	{{- end }}

	// +--------------------------------------------------+
	// | End Type Definition For: {{ $type }}
	// +--------------------------------------------------+

{{- end }}


{{- define "functions" }}
	func {{ .Name }}Name() string { 
		return _{{ .Name }}Name
	}
	
	{{ $array := (isArray (index .Specs 0)) }}

	{{- if eq $array 0}}
		
		{{ $concreteType := (trimPrefix .Field "*") }}
		{{ $isPointer := false }}
		{{- if ne $concreteType .Field }} {{ $isPointer = true}} {{- end }}

		func (x {{ .Type }}) Set{{ .Name }}(v  {{ .Field }}) ({{ .Type }}, error) {
			{{- if eq $isPointer true }}
				if v == nil { 
					return x, nil
				}
			{{- end }}

			for i := range x {
				if x[i].Key == {{ .Name }}Name() {
					x[i].Value = {{- if eq $isPointer true }}*{{- end }}v
					return x, nil
				}
			}
			return append(x, bson.E{Key: {{ .Name }}Name(), Value: {{- if eq $isPointer true }}*{{- end }}v}), nil
		}

		func (x {{ .Type }}) Get{{ .Name }}() ({{ .Field }}, error) {
			for _, i := range x {
				if i.Key != {{ .Name }}Name() {
					continue
				}
				switch t := i.Value.(type) {
					case {{ $concreteType }}: {
						return {{- if eq $isPointer true }}&{{- end }}t, nil
					}
					case {{ .Field }}: {
						return t, nil
					}
					{{- if eq .IsBsonType true }}
					case bson.D: {
						return {{ .Field }}(t), nil
					}
					{{- end }}
					case nil: {
						return nil, nil
					}
					default: {
						return nil, fmt.Errorf("unexpected BSON value type %T for field %s", t,	{{ .Name }}Name())
					}
				}
			}

			return nil, bsoncore.ErrElementNotFound
		}

		func {{ .Name }}BsonE(v  {{ .Field }}) bson.E {
			{{- if eq $isPointer true }}
				if v == nil { 
					return bson.E{Key: {{ .Name }}Name(), Value: nil}
				}
			{{- end }}
			return bson.E{Key: {{ .Name }}Name(), Value: {{- if eq $isPointer true }}*{{- end }}v}
		}
	{{- else }}
		func (x {{ .Type }}) Set{{ .Name }}(v  {{- range $array }} [] {{- end }}{{ .Field }}) ({{ .Type }}, error) {
			for i := range x {
				if x[i].Key == {{ .Name }}Name() {
					x[i].Value = v
					return x, nil
				}
			}
			return append(x, bson.E{Key: {{ .Name }}Name(), Value: v}), nil
		}

		func (x {{ .Type }}) Get{{ .Name }}() ({{- range $array }} [] {{- end }}{{ .Field }}, error) {
			for _, i := range x {
				if i.Key != {{ .Name }}Name() {
					continue
				}
				switch t := i.Value.(type) {
					case {{- range $array }} [] {{- end }}{{ .Field }}: {
						return t, nil
					}
					case nil: {
						return nil, nil
					}
					default: {
						var out {{- range $array }} [] {{- end }}{{ .Field }}
						if err := tools.Copy(t, &out); err != nil { 
							return nil, err
						}
						return out, nil
					}
				}
			}

			return nil, bsoncore.ErrElementNotFound
		}	

		func {{ .Name }}BsonE(v  {{ .Field }}) bson.E {
			return bson.E{Key: {{ .Name }}Name(), Value: v}
		}		
	{{- end }}
{{- end }}