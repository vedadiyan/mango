package {{ .PackageName }}

import (
{{- range $import := .ImportList }}
	"{{ $import }}"
{{- end }}

)

{{- range $type, $fields := .Fields }}
	{{- if hasPrefix $type "$" }} 
		// +--------------------------------------------------+
		// | Begin Enum Definition For: {{ $type }}
		// +--------------------------------------------------+
		{{ $typeName := trimPrefix $type "$" }}
		type {{ $typeName }} {{ index (index $fields "$type") 0}}
		{{- range $enumKey, $enumValue := $fields }}
			{{- if eq $enumKey "$type"}} {{ continue }} {{- end }}
			const {{ $enumKey }}  {{ $typeName }} = {{ index $enumValue 0 }} 
		{{- end }}
		// +--------------------------------------------------+
		// | End Enum Definition For: {{ $type }}
		// +--------------------------------------------------+
		{{ continue }} 
	{{- end }}

	// +--------------------------------------------------+
	// | Begin Type Definition For: {{ $type }}
	// +--------------------------------------------------+

	type {{ $type }} bson.D

	type {{ $type }}Type[T any] struct {
		Root T `bson:"inline"`
	} 
	
	{{- range $fieldName, $specs := $fields }}

		// +--------------------------------------------------+
		// |    Begin Field Definition For: {{ $fieldName }}
		// +--------------------------------------------------+


		{{- if hasPrefix (index $specs 0) "$" }} 
			type {{ $type }}{{ $fieldName }}Specs struct {
				{{ $fieldName }}  {{ trimPrefix (index $specs 0) "$" }}  {{ index $specs 1 }}
			}

			var _{{ $type }}{{ $fieldName }}Name = tools.FieldName[{{ $type }}{{ $fieldName }}Specs]()

			func {{ $type }}{{ $fieldName }}Name() string { 
				return _{{ $type }}{{ $fieldName }}Name
			}
			
			{{ continue }}
		{{- end }}
		
		{{ $genericType := (genericType (index $specs 0)) }}
		{{ $name :=  (printf "%s%s" $type $fieldName) }}

		{{- if ne $genericType (index $specs 0) }} 
			type {{ $type }}{{ $fieldName }}Specs[T any] struct {
				{{ $fieldName }} {{ $genericType }} {{ index $specs 1 }}
			}
			var _{{ $type }}{{ $fieldName }}Name = tools.FieldName[{{ $type }}{{ $fieldName }}Specs[any]]()
			{{ template "functions" (
				dict 
					"Field" 		(printf "%s%s" $type $fieldName) 
					"Name" 			$name
					"Specs" 		$specs 
					"Type" 			$type 
					"IsBsonType" 	true
				) 
			}}

		{{- else }}
			type {{ $type }}{{ $fieldName }}Specs struct {
				{{ $fieldName }}  {{ index $specs 0 }}  {{ index $specs 1 }}
			}
			var _{{ $type }}{{ $fieldName }}Name = tools.FieldName[{{ $type }}{{ $fieldName }}Specs]()

			{{ template "functions" (
				dict 
					"Field" 		(index $specs 0)  
					"Name" 			$name
					"Specs" 		$specs 
					"Type" 			$type 
					"IsBsonType" 	false
				) 
			}}

		{{- end }}

		// +--------------------------------------------------+
		// |    End Field Definition For: {{ $fieldName }}
		// +--------------------------------------------------+

	{{- end }}

	// +--------------------------------------------------+
	// | End Type Definition For: {{ $type }}
	// +--------------------------------------------------+

{{- end }}


{{- define "functions" }}
	func {{ .Name }}Name() string { 
		return _{{ .Name }}Name
	}
	
	{{ $array := (arraySymbol (index .Specs 0)) }}

	{{- if eq $array ""}}
		
		{{ $indirectType := (trimPrefix .Field "*") }}
		{{ $isPointer := false }}
		{{- if ne $indirectType .Field }} {{ $isPointer = true}} {{- end }}

		{{- if eq $isPointer true }}
			func (x {{ .Type }}) Set{{ .Name }}(v  {{ .Field }}) ({{ .Type }}, error) {
				for i := range x {
					if x[i].Key == {{ .Name }}Name() {
						if v == nil {
							x[i].Value = nil
							return x, nil
						}
						x[i].Value = *v
						return x, nil
					}
				}
				
				if v == nil {
					return append(x, bson.E{Key: {{ .Name }}Name(), Value: nil}), nil
				}
				return append(x, bson.E{Key: {{ .Name }}Name(), Value: *v}), nil
			}		
		{{- else }}
			func (x {{ .Type }}) Set{{ .Name }}(v  {{ .Field }}) ({{ .Type }}, error) {
				for i := range x {
					if x[i].Key == {{ .Name }}Name() {
						x[i].Value = v
						return x, nil
					}
				}
				return append(x, bson.E{Key: {{ .Name }}Name(), Value: v}), nil
			}				
		{{- end }}

		{{- if or (eq $isPointer true) (eq .IsBsonType true)}}

			func (x {{ .Type }}) Set{{ .Name }}IfPresent(v  {{ .Field }}) ({{ .Type }}, error) {
				if v == nil { 
					return x, nil
				}
				
				return x.Set{{ .Name }}(v)
			}				
		{{- end }}

		func (x {{ .Type }}) Get{{ .Name }}() ({{ .Field }}, error) {
			var zero {{ .Field }}
			for _, i := range x {
				if i.Key != {{ .Name }}Name() {
					continue
				}
				switch t := i.Value.(type) {
					{{- if eq $isPointer true }}
					case {{ $indirectType }}: {
						return &t, nil
					}
					{{- end }}
					case {{ .Field }}: {
						return t, nil
					}
					{{- if eq .IsBsonType true }}
					case bson.D: {
						return {{ .Field }}(t), nil
					}
					{{- end }}
					{{- if or (eq $isPointer true) (eq .IsBsonType true)}}
					case nil: {
						return zero, nil
					}
					{{- end }}
					default: {
						return zero, fmt.Errorf("unexpected BSON value type %T for field %s", t,	{{ .Name }}Name())
					}
				}
			}

			return zero, bsoncore.ErrElementNotFound
		}

		func {{ .Name }}BsonE(v  {{ .Field }}) bson.E {
			{{- if eq $isPointer true }}
				if v == nil { 
					return bson.E{Key: {{ .Name }}Name(), Value: nil}
				}
			{{- end }}
			return bson.E{Key: {{ .Name }}Name(), Value: {{- if eq $isPointer true }}*{{- end }}v}
		}
	{{- else }}
		func (x {{ .Type }}) Set{{ .Name }}(v  {{ $array }}{{ .Field }}) ({{ .Type }}, error) {
			for i := range x {
				if x[i].Key == {{ .Name }}Name() {
					x[i].Value = v
					return x, nil
				}
			}
			return append(x, bson.E{Key: {{ .Name }}Name(), Value: v}), nil
		}

		func (x {{ .Type }}) Set{{ .Name }}IfPresent(v  {{ $array }}{{ .Field }}) ({{ .Type }}, error) {
			if v == nil {
				return x, nil
			}

			for i := range x {
				if x[i].Key == {{ .Name }}Name() {
					x[i].Value = v
					return x, nil
				}
			}
			return append(x, bson.E{Key: {{ .Name }}Name(), Value: v}), nil
		}

		func (x {{ .Type }}) Get{{ .Name }}() ({{ $array }}{{ .Field }}, error) {
			for _, i := range x {
				if i.Key != {{ .Name }}Name() {
					continue
				}
				switch t := i.Value.(type) {
					case {{ $array }}{{ .Field }}: {
						return t, nil
					}
					case nil: {
						return nil, nil
					}
					default: {
						var out {{ $array }}{{ .Field }}
						if err := tools.Copy(t, &out); err != nil { 
							return nil, err
						}
						return out, nil
					}
				}
			}

			return nil, bsoncore.ErrElementNotFound
		}	

		func {{ .Name }}BsonE(v  {{ $array }}{{ .Field }}) bson.E {
			return bson.E{Key: {{ .Name }}Name(), Value: v}
		}		
	{{- end }}
{{- end }}